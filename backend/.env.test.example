# Application
NODE_ENV=test
PORT=3334

# Database
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=template_test
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/template_test?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/template_test?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0

# Upload
MAX_UPLOAD_SIZE=52428800
LOG_SYNC_MAX_BYTES=1048576

# Cache
CACHE_TTL_SECONDS=60
