# Application
NODE_ENV=development
PORT=3333
# Serve Swagger UI at /docs (defaults to on unless NODE_ENV=production)
ENABLE_SWAGGER=true

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=template_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Upload (50 MB default)
MAX_UPLOAD_SIZE=52428800
# Files larger than this are processed asynchronously (return PENDING, poll GET /log-files/:id)
LOG_SYNC_MAX_BYTES=1048576
# Optional override for upload spool directory (defaults to OS temp dir)
# UPLOAD_TEMP_DIR=/tmp/log-uploads

# Background queue for large-file processing
# inline = setImmediate in-process (default); bullmq = Redis-backed BullMQ
LOG_QUEUE_DRIVER=inline
LOG_QUEUE_CONCURRENCY=1
LOG_QUEUE_ATTEMPTS=3

# Cache
CACHE_TTL_SECONDS=60
